# Postgres (docker-compose dung cong 5433 tren host)
DATABASE_URL=postgres://bid:bid@localhost:5433/bid
# Mat khau Postgres. BAT BUOC khi trien khai bang docker-compose.prod.yml.
# Gia tri "bid" chi dung duoc o may dev.
POSTGRES_PASSWORD=bid

# Chuoi bi mat ky session cookie. Sinh bang: openssl rand -base64 32
# Bat buoc >=32 ky tu. App tu choi khoi dong neu con la placeholder.
AUTH_SECRET=

# Mui gio hien thi cua doi (dung cho dem nguoc va digest)
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh


# So trang lay moi nguon cho mot tu khoa (K trong plan)
PAGES_PER_SEARCH=2

# TTL cache ket qua theo tu khoa (gio)
KEYWORD_CACHE_TTL_HOURS=6

# Email (Resend) - de trong thi he thong chi ghi log thay vi gui that
RESEND_API_KEY=
ALERT_EMAIL_FROM=bid-portal@example.com

# Cong publish cua web khi chay docker-compose.prod.yml
WEB_PORT=3100

# User-Agent cua crawler — dat email that cua doi truoc khi chay production
CRAWLER_USER_AGENT=

# So ngay giu du lieu sau khi phien ket thuc
RETENTION_DAYS=90
